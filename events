<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>What's On — The Roundy</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display&family=Roboto&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      background-color: #fdf9f4;
      color: #2c2a28;
    }

    .event-wrapper {
      max-width: 1000px;
      margin: 40px auto;
      padding: 20px;
    }

    .event-header {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      text-align: center;
      margin-bottom: 30px;
      color: #2c2a28;
    }

    .event-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
    }

    .event-card {
      display: block;
      text-decoration: none;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      transition: transform 0.3s ease;
    }

    .event-card:hover {
      transform: scale(1.02);
    }

    .event-image {
      width: 100%;
      height: 200px;
      background-size: cover;
      background-position: center;
    }

    .event-info {
      padding: 15px;
    }

    .event-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.2rem;
      color: #8B5E3C;
      margin: 0 0 10px;
    }

    .event-date {
      font-size: 1rem;
      color: #2c2a28;
      margin: 0;
    }
  </style>
</head>
<body>
  <div class="event-wrapper">
    <h1 class="event-header">What’s On</h1>
    <div class="event-list">

      <a class="event-card" href="https://www.theroundy.com/whats-on/stand-up-comedy-club-low-key-funny-2025-10-22-11187821">
        <div class="event-image" style="background-image: url('http://www.peoplesrepublicofcork.com/eventguide/uploads/orig/2024feb_5290368.jpg');"></div>
        <div class="event-info">
          <h2 class="event-title">Stand-up Comedy Club: Low-key Funny</h2>
          <p class="event-date">Wed 22nd Oct, 8:30 pm</p>
        </div>
      </a>

      <a class="event-card" href="https://www.theroundy.com/whats-on/stand-up-comedy-club-thursday-showcase-2025-10-23-11187844">
        <div class="event-image" style="background-image: url('http://www.peoplesrepublicofcork.com/eventguide/uploads/orig/2023dec_6145243.jpg');"></div>
        <div class="event-info">
          <h2 class="event-title">Stand-up Comedy Club: Thursday Showcase</h2>
          <p class="event-date">Thu 23rd Oct, 8:30 pm</p>
        </div>
      </a>

      <a class="event-card" href="https://www.theroundy.com/whats-on/stand-up-comedy-club-low-key-funny-2025-10-29-11187822">
        <div class="event-image" style="background-image: url('http://www.peoplesrepublicofcork.com/eventguide/uploads/orig/2024feb_5290368.jpg');"></div>
        <div class="event-info">
          <h2 class="event-title">Stand-up Comedy Club: Low-key Funny</h2>
          <p class="event-date">Wed 29th Oct, 8:30 pm</p>
        </div>
      </a>

      <a class="event-card" href="https://www.theroundy.com/whats-on/off-the-stage-corks-comedy-gong-show-halloween-edition-2025-10-30-11187845">
        <div class="event-image" style="background-image: url('http://www.peoplesrepublicofcork.com/eventguide/uploads/orig/2025oct_1195754.jpg');"></div>
        <div class="event-info">
          <h2 class="event-title">Off The Stage: Cork’s Comedy Gong Show (Halloween Edition)</h2>
          <p class="event-date">Thu 30th Oct, 8:30 pm</p>
        </div>
      </a>

    </div>
  </div>
</body>
</html>
